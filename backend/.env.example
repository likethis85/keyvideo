# Service Configurations
PORT=3001
# Bind to loopback by default. Set HOST=0.0.0.0 only behind a trusted firewall/reverse proxy.
HOST=127.0.0.1
# Comma-separated browser origins allowed to call this service.
# Desktop Tauri requests do not send a browser Origin header and remain supported.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://www.marius.com.cn,https://marius.com.cn
# Maximum raw upload size in megabytes.
MAX_UPLOAD_MB=100
# Maximum JSON body size (base64 image payloads can be large; keep bounded).
MAX_JSON_MB=50
# Per-authenticated-user API request limit per minute.
API_RATE_LIMIT_PER_MINUTE=600
# Hard cap for the in-process rate-limit bucket map.
API_RATE_BUCKET_CAPACITY=5000
# Hard cap for the verified Supabase token cache (entries evicted oldest-first).
AUTH_TOKEN_CACHE_MAX_ENTRIES=5000
# Reuse identical generation responses for this many seconds.
IDEMPOTENCY_TTL_SECONDS=30
# Timeout for ordinary external API calls and long-running AI responses.
EXTERNAL_REQUEST_TIMEOUT_SECONDS=30
LONG_AI_REQUEST_TIMEOUT_SECONDS=180
# Paid generation guards (per authenticated user): accepted tasks per UTC day and
# simultaneous submissions. Invalid or over-quota requests never reach the provider.
AI_DAILY_TASK_LIMIT=200
AI_MAX_CONCURRENT_TASKS=6

# Unified SSO (marius-sso)
# Register the callback below in the SSO admin console. It must match byte-for-byte.
# Local development: http://127.0.0.1:3001/api/auth/sso/callback
# Production web:   https://www.marius.com.cn/videos/api/auth/sso/callback
SSO_BASE_URL=https://sso.marius.com.cn
SSO_CLIENT_ID=app_xxxxxxxxxxxxxxxxxxxx
SSO_CLIENT_SECRET=YOUR_SSO_CLIENT_SECRET
SSO_REDIRECT_URI=http://127.0.0.1:3001/api/auth/sso/callback
# Browser page to open after the SSO callback. Use the frontend origin, not the API.
SSO_POST_LOGIN_REDIRECT=http://localhost:5173/
# Optional extra origins accepted from the return_to parameter (comma-separated).
SSO_ALLOWED_RETURN_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://www.marius.com.cn,https://marius.com.cn,http://tauri.localhost,tauri://localhost
# Optional dedicated signing key for KeyVideo sessions. If omitted, a key is derived
# from SSO_CLIENT_ID + SSO_CLIENT_SECRET. Rotating it logs every SSO user out.
# SSO_SESSION_SECRET=YOUR_RANDOM_SESSION_SECRET
# Lifetime of the KeyVideo session in seconds (default 8 hours).
SSO_SESSION_TTL_SECONDS=28800

# API authentication. SSO session tokens are always accepted. To keep the legacy
# Supabase email/password login working, configure the same Supabase instance:
# SUPABASE_URL=https://your-supabase-instance.example.com
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Local-only escape hatch; ignored when NODE_ENV=production:
# API_AUTH_DISABLED=true

# Sandbase AI API Configurations (Image & Video Generation)
# AI capabilities for Mannequin, Tryon, Background, and Kling Video run via Sandbase.
SANDBASE_API_KEY=YOUR_SANDBASE_API_KEY
# Optional custom models for Sandbase chat completions (defaults to google/gemini-2.5-flash)
# SANDBASE_CHAT_MODEL=google/gemini-2.5-flash

# Text LLM Configuration (Optional Dedicated OpenAI-Compatible Endpoint for Stylist & Prompts)
# When configured, /api/ai/stylist and /api/ai/prompts-skill will prioritize this endpoint.
TEXT_LLM_API_KEY=YOUR_TEXT_LLM_API_KEY
TEXT_LLM_URL=https://aigw.telecomjs.com/v1/chat/completions
TEXT_LLM_MODEL=deepseek-v4-flash-0731-tem

# Aliyun OSS Configurations
OSS_REGION=oss-cn-shanghai
OSS_ACCESS_KEY_ID=YOUR_OSS_ACCESS_KEY_ID
OSS_ACCESS_KEY_SECRET=YOUR_OSS_ACCESS_KEY_SECRET
OSS_BUCKET=marius
