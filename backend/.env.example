# Service Configurations
PORT=3001
# Comma-separated browser origins allowed to call this service.
# Desktop Tauri requests do not send a browser Origin header and remain supported.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Maximum raw upload size in megabytes.
MAX_UPLOAD_MB=100
# Reuse identical generation responses for this many seconds.
IDEMPOTENCY_TTL_SECONDS=30
# Timeout for ordinary external API calls and long-running AI responses.
EXTERNAL_REQUEST_TIMEOUT_SECONDS=30
LONG_AI_REQUEST_TIMEOUT_SECONDS=180

# AI Gateway Configurations (Image)
AIGATEWAY_URL=https://aigateway.edgecloudapp.com/v1/625dad2ce0ea51bd6db4bc4cfdf5eaf6/wuxi_lairui-gateway
AIGATEWAY_TOKEN=YOUR_AI_GATEWAY_TOKEN

# AI Gateway Configurations (Video)
AIGATEWAY_VIDEO_URL=https://aigateway.edgecloudapp.com/v1/625dad2ce0ea51bd6db4bc4cfdf5eaf6/wuxi_lairui-gateway3
AIGATEWAY_VIDEO_TOKEN=YOUR_AI_GATEWAY_VIDEO_TOKEN

# Aliyun OSS Configurations
OSS_REGION=oss-cn-shanghai
OSS_ACCESS_KEY_ID=YOUR_OSS_ACCESS_KEY_ID
OSS_ACCESS_KEY_SECRET=YOUR_OSS_ACCESS_KEY_SECRET
OSS_BUCKET=marius

# Sandbase AI API Configurations
SANDBASE_API_KEY=YOUR_SANDBASE_API_KEY
