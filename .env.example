# Public frontend configuration only. Never put OSS secrets or private AI tokens
# in VITE_ variables because Vite embeds them in the browser/desktop bundle.
VITE_SUPABASE_URL=https://your-supabase-instance.example.com
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_BACKEND_URL=http://127.0.0.1:3001
